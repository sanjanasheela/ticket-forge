{
  "title": "TicketForge - Phase 1 Monolith",
  "uid": "ticketforge-p1",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "ticketforge"
  ],
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }

#!/usr/bin/env bash
# Run ForgeKV from the packaged jar (build it with `mvn package`).
# Every argument is passed through, e.g. ./forgekv --port 6380 --shards 4
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
jar="$here/target/forgekv.jar"
if [[ ! -f "$jar" ]]; then
  echo "forgekv: $jar not found; build it first with: mvn -q -DskipTests package" >&2
  exit 1
fi
exec java --enable-native-access=ALL-UNNAMED ${FORGEKV_JAVA_OPTS:-} -jar "$jar" "$@"

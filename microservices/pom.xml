<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.ticketforge.ms</groupId>
    <artifactId>ticketforge-ms</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>TicketForge Microservices (Phase 2 parent)</name>
    <description>Phase 2: the Phase 1 monolith split into services on Kong, Redis, Kafka and PostgreSQL</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <modules>
        <module>common</module>
        <module>custom/forgelog</module>
        <module>messaging</module>
        <module>contracts</module>
        <module>auth-service</module>
        <module>catalog-service</module>
        <module>reservation-service</module>
        <module>booking-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.ticketforge.ms</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ticketforge.ms</groupId>
                <artifactId>messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ticketforge.ms</groupId>
                <artifactId>forgelog</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ticketforge.ms</groupId>
                <artifactId>contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
